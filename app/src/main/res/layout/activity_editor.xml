<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Sentia.IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/dotDirty"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle_ink"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFilePath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxLines="1"
                android:textColor="@color/ink_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnUndo"
            style="@style/Sentia.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/ed_undo"
            android:padding="10dp"
            android:src="@drawable/ic_undo"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnRedo"
            style="@style/Sentia.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/ed_redo"
            android:padding="10dp"
            android:src="@drawable/ic_redo"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSave"
            style="@style/Sentia.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/save"
            android:padding="10dp"
            android:src="@drawable/ic_save"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/Sentia.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_more"
            android:padding="10dp"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/drawer_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etFind"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="@string/ed_find_hint"
                android:imeOptions="flagNoExtractUi|actionSearch"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFindCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipCase"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="@string/ed_case"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipRegex"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="@string/ed_regex"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                style="@style/Sentia.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/ed_prev"
                android:padding="9dp"
                android:src="@drawable/ic_chev_up" />

            <ImageButton
                android:id="@+id/btnFindNext"
                style="@style/Sentia.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/ed_next"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_down" />

            <ImageButton
                android:id="@+id/btnFindClose"
                style="@style/Sentia.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cd_close"
                android:padding="9dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replaceRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etReplace"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="@string/ed_replace_hint"
                android:imeOptions="flagNoExtractUi"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnReplace"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_nude"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/ed_replace"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnReplaceAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill_nude"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/ed_replace_all"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.sentia.ai.app.ui.CodeEditorView
            android:id="@+id/codeEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <com.sentia.ai.app.ui.ZoomImageView
            android:id="@+id/ivViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/ed_image"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/stateBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_alert"
                app:tint="@color/ink_muted" />

            <TextView
                android:id="@+id/tvStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStateSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnStateClose"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_ink"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/ed_close_file"
                android:textColor="@color/on_ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@color/drawer_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCursor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/symbolScroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/nude"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/symbolRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>
</LinearLayout>
