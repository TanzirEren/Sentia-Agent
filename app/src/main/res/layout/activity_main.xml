<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/Sentia.IconButton"
                android:layout_width="@dimen/icon_btn"
                android:layout_height="@dimen/icon_btn"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_menu"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="64dp"
                android:layout_marginEnd="64dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnFiles"
                style="@style/Sentia.IconButton"
                android:layout_width="@dimen/icon_btn"
                android:layout_height="@dimen/icon_btn"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="50dp"
                android:contentDescription="@string/cd_files"
                android:src="@drawable/ic_workspace"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnNewChat"
                style="@style/Sentia.IconButton"
                android:layout_width="@dimen/icon_btn"
                android:layout_height="@dimen/icon_btn"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/cd_new_chat"
                android:src="@drawable/ic_new_chat" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingTop="6dp"
            android:paddingBottom="14dp"
            app:layout_constraintBottom_toTopOf="@id/inputArea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/inputArea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintVertical_bias="0.40">

            <ImageView
                android:layout_width="92dp"
                android:layout_height="87dp"
                android:contentDescription="@string/cd_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_mark" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/greeting"
                android:textColor="@color/ink"
                android:textSize="24sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnScrollDown"
            style="@style/Sentia.CircleButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_circle_card"
            android:contentDescription="@string/cd_scroll_down"
            android:elevation="2dp"
            android:src="@drawable/ic_arrow_down"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/inputArea"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/inputArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/editBanner"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_edit_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/editing_message"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnCancelEdit"
                    style="@style/Sentia.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/cd_close"
                    android:padding="10dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSlash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/inputCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAttachments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/etInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="@string/hint_message"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="8"
                        android:minHeight="48dp"
                        android:paddingStart="18dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_faint"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:paddingEnd="18dp"
                        android:textColor="@color/ink_faint"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageButton
                            android:id="@+id/btnAttach"
                            style="@style/Sentia.CircleButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/cd_attach"
                            android:src="@drawable/ic_plus" />

                        <TextView
                            android:id="@+id/tvModel"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_nude"
                            android:drawableEnd="@drawable/ic_chevron_down"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/ink_muted"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxWidth="200dp"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp"
                            android:text="@string/select_model"
                            android:textColor="@color/ink"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnMic"
                            style="@style/Sentia.CircleButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/cd_mic"
                            android:src="@drawable/ic_mic" />

                        <ImageButton
                            android:id="@+id/btnSend"
                            style="@style/Sentia.CircleButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_circle_ink"
                            android:contentDescription="@string/cd_send"
                            android:src="@drawable/ic_arrow_up"
                            app:tint="@color/on_ink" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/drawer_content"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <FrameLayout
        android:id="@+id/explorerDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/drawer_bg"
        android:clickable="true"
        android:focusable="true" />
</androidx.drawerlayout.widget.DrawerLayout>
