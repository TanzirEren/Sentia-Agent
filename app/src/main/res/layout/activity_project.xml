<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Sentia.IconButton"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="108dp"
                android:layout_marginEnd="108dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnPin"
                style="@style/Sentia.IconButton"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="56dp"
                android:contentDescription="@string/act_pin_project"
                android:src="@drawable/ic_pin" />

            <ImageButton
                android:id="@+id/btnMore"
                style="@style/Sentia.IconButton"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/cd_more"
                android:src="@drawable/ic_more" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="104dp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="22dp"
        android:text="@string/new_chat"
        android:textColor="@color/on_ink"
        android:textSize="14sp"
        app:backgroundTint="@color/ink"
        app:icon="@drawable/ic_new_chat"
        app:iconTint="@color/on_ink" />
</FrameLayout>
