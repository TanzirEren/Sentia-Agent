<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/msg_margin_h"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/msg_margin_h"
    android:paddingBottom="6dp">

    <com.sentia.ai.app.ui.TypingDotsView
        android:id="@+id/dots"
        android:layout_width="44dp"
        android:layout_height="22dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/blocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnCopy"
            style="@style/Sentia.IconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/cd_copy"
            android:padding="8dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/ink_muted" />

        <ImageButton
            android:id="@+id/btnRegen"
            style="@style/Sentia.IconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/cd_regenerate"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/ink_muted" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/Sentia.IconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/cd_more"
            android:padding="8dp"
            android:src="@drawable/ic_more"
            app:tint="@color/ink_muted" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
