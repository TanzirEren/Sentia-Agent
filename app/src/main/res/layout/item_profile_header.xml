<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="38sp" />

        <ImageButton
            android:id="@+id/btnAvatarEdit"
            style="@style/Sentia.CircleButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_circle_ink"
            android:contentDescription="@string/cd_edit_photo"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/on_ink" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ink"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvProfileSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />
</LinearLayout>
