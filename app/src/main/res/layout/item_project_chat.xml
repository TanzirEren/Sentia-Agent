<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chat"
        app:tint="@color/ink_muted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvChatDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivChatPinned"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:contentDescription="@string/cd_pin"
        android:src="@drawable/ic_pin_filled"
        android:visibility="gone"
        app:tint="@color/ink_faint" />

    <ImageButton
        android:id="@+id/btnChatMore"
        style="@style/Sentia.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/cd_more"
        android:padding="11dp"
        android:src="@drawable/ic_more"
        app:tint="@color/ink_muted" />
</LinearLayout>
