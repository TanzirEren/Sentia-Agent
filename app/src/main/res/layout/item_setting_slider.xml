<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSliderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSliderValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderSet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:thumbColor="@color/ink"
        app:trackColorActive="@color/ink"
        app:trackColorInactive="@color/nude"
        app:haloColor="@color/nude" />

    <TextView
        android:id="@+id/tvSliderPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_outline_box"
        android:padding="12dp"
        android:text="@string/text_preview"
        android:textColor="@color/ink"
        android:visibility="gone" />
</LinearLayout>
