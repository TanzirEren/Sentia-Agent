<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_card_outline"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/ivToolIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            app:tint="@color/ink" />

        <TextView
            android:id="@+id/tvToolName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvToolSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pbTool"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivToolStatus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvToolStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/ivToolChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/ink_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tool_input"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvToolIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tool_output"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvToolOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
